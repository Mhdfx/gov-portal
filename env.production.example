# Boiema Platform Production Environment Configuration

APP_NAME="Boiema Platform"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://boiema.gov.ma

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boiema_platform
DB_USERNAME=boiema_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@boiema.gov.ma
MAIL_FROM_NAME="${APP_NAME}"

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.boiema.gov.ma

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=boiema

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PASSWORD=YOUR_REDIS_PASSWORD
QUEUE_REDIS_PORT=6379

# Broadcasting Configuration
BROADCAST_DRIVER=redis
BROADCAST_REDIS_HOST=127.0.0.1
BROADCAST_REDIS_PASSWORD=YOUR_REDIS_PASSWORD
BROADCAST_REDIS_PORT=6379

# File System Configuration
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Security Configuration
SANCTUM_STATEFUL_DOMAINS=boiema.gov.ma,www.boiema.gov.ma
SESSION_DOMAIN=.boiema.gov.ma

# Performance Configuration
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_INTERNED_STRINGS_BUFFER=8
OPCACHE_MAX_ACCELERATED_FILES=4000
OPCACHE_REVALIDATE_FREQ=2
OPCACHE_FAST_SHUTDOWN=1

# Monitoring Configuration
TELESCOPE_ENABLED=false
LOG_VIEWER_ENABLED=false

# Backup Configuration
BACKUP_DISK=local
BACKUP_NOTIFICATION_MAIL_ADDRESS=admin@boiema.gov.ma

# SEO Configuration
SEO_TITLE="Boiema Platform - Portail Gouvernemental"
SEO_DESCRIPTION="Plateforme gouvernementale pour l'entrepreneuriat et l'investissement au Maroc"
SEO_KEYWORDS="entrepreneuriat, investissement, Maroc, gouvernement, boiema"

# Localization Configuration
LOCALE_DEFAULT=fr
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=fr,ar,en

# Feature Flags
FEATURE_BLOG=true
FEATURE_NEWSLETTER=true
FEATURE_JOB_PORTAL=true
FEATURE_E_COMMERCE=true
FEATURE_NOTIFICATIONS=true
FEATURE_API=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=

# Social Media
FACEBOOK_URL=
TWITTER_URL=
LINKEDIN_URL=
INSTAGRAM_URL=

# Contact Information
CONTACT_EMAIL=contact@boiema.gov.ma
CONTACT_PHONE=+212-5-XX-XX-XX-XX
CONTACT_ADDRESS="Ministère de l'Industrie, du Commerce et de l'Économie Verte et Numérique, Rabat, Maroc"

# Legal Information
TERMS_URL=/terms
PRIVACY_URL=/privacy
COOKIE_POLICY_URL=/cookie-policy






























